<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Native pickers (e.g. DatePickerDialog) read colorPrimary / colorAccent -->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorPrimaryDark">@color/app_primary_dark</item>
        <item name="colorAccent">@color/app_primary</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Branded launch window while JS / Metro loads: navy + centered app mark,
             matching the JS FullScreenLoader for a seamless cold-start transition. -->
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>

</resources>
